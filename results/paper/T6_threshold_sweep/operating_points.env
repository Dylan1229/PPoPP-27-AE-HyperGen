# Cache operating points, chosen by run/lib/pick_operating_points.sh
#
# Rule: per backbone, the FASTEST threshold whose LPIPS against its own no-cache output
# stays under 0.05. LPIPS is a perceptual distance whose scale means the same thing
# across backbones; PSNR against different references does not, and a shared dB floor just
# picked whichever sampled point sat above it. Ties broken by retention.
#
# LPIPS_CAP=0.05
# Regenerate rather than editing.
#
# Use the PER-BACKBONE variable. One shared CACHE_THRESH is what left Wan running at 0.09
# with the threshold hard-coded and its cache effectively inert.
#
# Generated 2026-08-03T02:16:08+00:00 from /home/ubuntu/repo/UltraGen-PPoPP-experiments/results/T6_threshold_sweep/quality.tsv

CACHE_THRESH_COG=0.20   # 1.74x, skip 0.4286, PSNR 37.06 dB, LPIPS 0.039
CACHE_THRESH_HUNYUAN=0.06   # 1.34x, skip 0.2571, PSNR 37.30 dB, LPIPS 0.046
CACHE_THRESH_WAN_I2V=0.15   # 1.24x, skip 0.3143, PSNR 31.46 dB, LPIPS 0.047
CACHE_THRESH_WAN_T2V=0.20   # 1.27x, skip 0.3143, PSNR 31.96 dB, LPIPS 0.042

# Inherited from CogVideoX's 25-cell grid, not swept per backbone: Wan has no per-tile
# scale knob, and on that grid the scale axis moves skip rate by 0.029-0.143 against 0.31
# for the threshold axis.
STATIC_SCALE=0.5

# Why each was chosen:
#   cog       thr=0.20   fastest with LPIPS <= 0.05 (3 of 6 points qualify)
#   hunyuan   thr=0.06   fastest with LPIPS <= 0.05 (3 of 10 points qualify)
#   wan_i2v   thr=0.15   fastest with LPIPS <= 0.05 (5 of 8 points qualify)
#   wan_t2v   thr=0.20   fastest with LPIPS <= 0.05 (6 of 8 points qualify)
